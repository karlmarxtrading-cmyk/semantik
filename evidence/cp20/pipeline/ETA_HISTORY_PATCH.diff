+export function createPageEta({minimumSamples=3,windowSize=8}={}){
+  const samples=[];
+  return {
+    record({durationMs,worked,partialResume=false}){if(!worked||partialResume||!Number.isFinite(durationMs)||durationMs<=0)return;samples.push(durationMs);if(samples.length>windowSize)samples.shift();},
